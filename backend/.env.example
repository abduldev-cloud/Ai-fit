# --- Global Settings ---
PROJECT_NAME="FitMind AI"
API_STR="/api/v1"

# --- Database (MySQL) ---
# Replace with your MySQL Workbench credentials
DATABASE_URL="mysql+mysqlconnector://root:password@localhost:3306/fitmind_db"

# --- Authentication ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="YOUR_SUPER_SECRET_KEY_HERE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Gemini ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
AI_MODEL="gemini-1.5-flash"

# --- Frontend Settings (Auto-synced to frontends on start) ---
REACT_APP_API_URL="http://localhost:8000/api/v1"
EXPO_PUBLIC_API_URL="http://192.168.29.106:8000/api/v1"
